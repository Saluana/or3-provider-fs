{
    "name": "or3-provider-fs",
    "version": "0.0.6",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Saluana/or3-provider-fs.git"
    },
    "description": "Filesystem storage provider for OR3 Chat — local-disk blob storage via signed tokens.",
    "license": "MIT",
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "packageManager": "bun@1.3.14",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/types.d.mts",
            "import": "./dist/module.mjs"
        },
        "./nuxt": {
            "types": "./dist/types.d.mts",
            "import": "./dist/module.mjs"
        }
    },
    "main": "./dist/module.mjs",
    "types": "./dist/types.d.mts",
    "files": [
        "dist"
    ],
    "scripts": {
        "prepack": "bun run build",
        "build": "nuxt-module-build build",
    "lint": "eslint . --max-warnings=0",
    "type-check": "tsc --noEmit",
    "type-check:standalone": "tsc -p tsconfig.release.json --noEmit",
    "test": "vitest run"
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "jsonwebtoken": "^9.0.3"
    },
    "peerDependencies": {
        "@nuxt/kit": "^3.0.0 || ^4.0.0",
        "nuxt": "^3.0.0 || ^4.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "@nuxt/module-builder": "^1.0.2",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^24.10.1",
        "eslint": "^9.39.1",
        "h3": "^1.15.4",
        "pathe": "^2.0.3",
        "typescript-eslint": "^8.46.2",
        "typescript": "^5.9.3",
        "vitest": "^4.0.18"
    }
}
